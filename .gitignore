# ==========================================
# DevOps Log Analyzer - Production .gitignore
# ==========================================

# ── Python / Backend ───────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
venv/
venv*/
ENV/
env/
.venv/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nox/
.hypothesis/
.ruff_cache/

# SQLite Databases & Local Data Files
*.db
*.sqlite
*.sqlite3
devops_log.db
devops_ai.db
backend/devops_log.db
backend/devops_ai.db

# ── Node.js / Frontend ─────────────────────
node_modules/
frontend/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build Output
.next/
frontend/.next/
out/

# Production / Bundles
build/
dist/

# Debug Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment & Secrets ──────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Vercel Integration
.vercel

# TypeScript Build Info
*.tsbuildinfo

# ── IDEs & Operating System ───────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor Directories (Optional)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
